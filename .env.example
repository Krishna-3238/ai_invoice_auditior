# Copy this file to .env and replace the sample values before starting services.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432

QDRANT_COLLECTION=invoice_chunks
ERP_CACHE_TTL_SECONDS=3600
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Langfuse tracing. Leave blank to use local trace logging.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Invoice text and model completions are excluded by default.
LANGFUSE_CAPTURE_CONTENT=false
IMAP_PORT=993
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
